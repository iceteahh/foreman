# Copy to .env and fill in. .env is gitignored; bin/harness loads it from the working directory.
ANTHROPIC_API_KEY=            # worker credential (sk-ant-api03-…); or use the OAuth token below
CLAUDE_CODE_OAUTH_TOKEN=      # from `claude setup-token` (sk-ant-oat01-…); one of the two is required
GITHUB_TOKEN=                 # repo clone + draft PRs (gh auth token works for local dev)
GITHUB_WEBHOOK_SECRET=        # openssl rand -hex 32; same value in the GitHub webhook config
SLACK_BOT_TOKEN=              # xoxb-… with chat:write; unset → review requests are only logged
SLACK_SIGNING_SECRET=         # verifies POST /slack/actions
HARNESS_LOG=info              # debug | info | warn | error
